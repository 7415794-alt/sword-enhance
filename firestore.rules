rules_version = '2';
// 온라인 랭킹용 Firestore 보안 규칙
// 누구나 읽을 수 있고, 정해진 형식의 점수만 쓸 수 있으며, 삭제는 불가
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'best', 'rebirths', 'score', 'bestSale', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 12
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 300
        && request.resource.data.rebirths is int && request.resource.data.rebirths >= 0
        && request.resource.data.score is int && request.resource.data.score >= 0;
      allow delete: if false;
    }
  }
}
